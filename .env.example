# Folha — variáveis de ambiente
# Copie para .env e ajuste para seu setup local.

# URL base da Folha.Api
# Android emulador → http://10.0.2.2:5002
# iOS simulator   → http://localhost:5002
# Device físico   → http://<seu-ip-na-rede>:5002 ou https URL pública
API_BASE_URL=http://10.0.2.2:5002

# Timeout em segundos para chamadas HTTP
API_TIMEOUT_SECONDS=15

# Ambiente (dev/staging/prod) — usado em logs e analytics
APP_ENV=dev

# Habilita logs verbosos do Dio (NÃO ative em produção)
ENABLE_NETWORK_LOGS=true
